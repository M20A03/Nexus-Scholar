generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Document {
  id            String         @id @default(uuid()) @db.Uuid
  title         String
  authors       String[]
  abstract      String?        @db.Text
  full_text     String         @db.Text
  file_type     String
  embedding     Unsupported("vector(768)")?
  relationships Relationship[]

  @@map("documents")
}

model Entity {
  id                    String         @id @default(uuid()) @db.Uuid
  name                  String
  type                  String         // 'author', 'concept', 'method', 'dataset'
  embedding             Unsupported("vector(768)")?
  source_relationships  Relationship[] @relation("SourceEntity")
  target_relationships  Relationship[] @relation("TargetEntity")

  @@map("entities")
}

model Relationship {
  id                String    @id @default(uuid()) @db.Uuid
  source_entity_id  String    @db.Uuid
  target_entity_id  String    @db.Uuid
  relationship_type String    // 'collaborates_with', 'uses_method', 'cites'
  confidence        Float
  evidence          String?   @db.Text
  document_id       String    @db.Uuid

  source_entity     Entity    @relation("SourceEntity", fields: [source_entity_id], references: [id])
  target_entity     Entity    @relation("TargetEntity", fields: [target_entity_id], references: [id])
  document          Document  @relation(fields: [document_id], references: [id])

  @@map("relationships")
}
