generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Author {
  id         String   @id @default(uuid())
  name       String
  orcid      String?  @unique
  department String?
  papers     Paper[]  @relation("PaperAuthors")
  // vector for author embeddings (optional)
  embeddings Unsupported("vector(768)")? 
}

model Paper {
  id          String   @id @default(uuid())
  title       String
  abstract    String?
  doi         String?  @unique
  year        Int?
  pdfUrl      String?
  publishedAt DateTime @default(now())
  authors     Author[] @relation("PaperAuthors")
  citationsFrom Citation[] @relation("CitationFrom")
  citationsTo   Citation[] @relation("CitationTo")
  embeddings  Unsupported("vector(768)")? // pgvector field
}

model Citation {
  id          String @id @default(uuid())
  sourceId    String // citing paper
  targetId    String // cited paper
  sourcePaper Paper @relation("CitationFrom", fields: [sourceId], references: [id])
  targetPaper Paper @relation("CitationTo", fields: [targetId], references: [id])
  @@unique([sourceId, targetId])
}

model Entity {
  id       String @id @default(uuid())
  name     String
  type     String // author, concept, method, dataset, department
  embeddings Unsupported("vector(768)")?
}

model Relationship {
  id          String @id @default(uuid())
  sourceId    String // entity id
  targetId    String
  type        String // researches, uses_method, belongs_to, etc.
  confidence Float?
  paperId     String? // optional link to paper
}
